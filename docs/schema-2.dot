digraph Schema {
graph [rankdir=TB, bgcolor="#fffdf8", pad="0.3", nodesep="0.4", ranksep="0.7", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Groupes et demandes d’avis"];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [color="#6b7d70", arrowsize=0.65, fontname="DejaVu Sans", fontsize=9];
"groupe_utilisateur" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>groupe_utilisateur</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_groupe</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_createur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nom</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_creation</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
"membre_groupe" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>membre_groupe</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK </TD><TD ALIGN="LEFT">id_groupe</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">PK FK </TD><TD ALIGN="LEFT">id_utilisateur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">role_groupe</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_adhesion</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
"demande_avis" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>demande_avis</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_demande</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_demandeur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_utilisateur_cible</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_groupe_cible</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">message_demande</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_demande</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">statut</TD><TD ALIGN="LEFT">ENUM</TD></TR></TABLE>>];
"destinataire_demande_avis" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>destinataire_demande_avis</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK </TD><TD ALIGN="LEFT">id_demande</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">PK FK </TD><TD ALIGN="LEFT">id_utilisateur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">statut_reponse</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_notification</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
"avis_fragment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>avis_fragment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_avis</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_demande</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_utilisateur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">type_avis</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">note</TD><TD ALIGN="LEFT">TINYINT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">commentaire</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_avis</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
"utilisateur" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>utilisateur</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_utilisateur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">pseudo</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_creation</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">actif</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR></TABLE>>];
"fragment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>fragment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_createur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_type_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_auteur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">texte</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">source_titre</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">source_url</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_creation</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">visibilite</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">supprime_logiquement</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR></TABLE>>];
"groupe_utilisateur" -> "utilisateur" [label="id_createur → id_utilisateur"];
"membre_groupe" -> "groupe_utilisateur" [label="id_groupe → id_groupe"];
"membre_groupe" -> "utilisateur" [label="id_utilisateur → id_utilisateur"];
"demande_avis" -> "fragment" [label="id_fragment → id_fragment"];
"demande_avis" -> "utilisateur" [label="id_demandeur → id_utilisateur"];
"demande_avis" -> "utilisateur" [label="id_utilisateur_cible → id_utilisateur"];
"demande_avis" -> "groupe_utilisateur" [label="id_groupe_cible → id_groupe"];
"destinataire_demande_avis" -> "demande_avis" [label="id_demande → id_demande"];
"destinataire_demande_avis" -> "utilisateur" [label="id_utilisateur → id_utilisateur"];
"avis_fragment" -> "demande_avis" [label="id_demande → id_demande"];
"avis_fragment" -> "fragment" [label="id_fragment → id_fragment"];
"avis_fragment" -> "utilisateur" [label="id_utilisateur → id_utilisateur"];
"fragment" -> "utilisateur" [label="id_createur → id_utilisateur"];
}
