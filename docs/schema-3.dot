digraph Schema {
graph [rankdir=TB, bgcolor="#fffdf8", pad="0.3", nodesep="0.4", ranksep="0.7", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Réapparition, historique et bilans"];
