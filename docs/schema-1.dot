digraph Schema {
graph [rankdir=TB, bgcolor="#fffdf8", pad="0.3", nodesep="0.4", ranksep="0.7", fontname="DejaVu Sans", fontsize=18, labelloc=t, label="Fragments et collections"];
node [shape=plain, fontname="DejaVu Sans", fontsize=11];
edge [color="#6b7d70", arrowsize=0.65, fontname="DejaVu Sans", fontsize=9];
"utilisateur" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>utilisateur</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_utilisateur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">pseudo</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_creation</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">actif</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR></TABLE>>];
"type_fragment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>type_fragment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_type_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">libelle</TD><TD ALIGN="LEFT">VARCHAR</TD></TR></TABLE>>];
"auteur" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>auteur</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_auteur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">nom</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">prenom</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD></TR></TABLE>>];
"fragment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>fragment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_createur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_type_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_auteur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">texte</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">source_titre</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">source_url</TD><TD ALIGN="LEFT">VARCHAR</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_creation</TD><TD ALIGN="LEFT">DATETIME</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">visibilite</TD><TD ALIGN="LEFT">ENUM</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">supprime_logiquement</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR></TABLE>>];
"collection_theme" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>collection_theme</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK </TD><TD ALIGN="LEFT">id_collection_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">PK FK </TD><TD ALIGN="LEFT">id_theme</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
"humeur" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>humeur</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_humeur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">libelle</TD><TD ALIGN="LEFT">VARCHAR</TD></TR></TABLE>>];
"mode_archivage" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>mode_archivage</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_mode_archivage</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">libelle</TD><TD ALIGN="LEFT">VARCHAR</TD></TR></TABLE>>];
"collection_fragment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>collection_fragment</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_collection_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_utilisateur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_humeur</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">FK </TD><TD ALIGN="LEFT">id_mode_archivage</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">commentaire_personnel</TD><TD ALIGN="LEFT">TEXT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">favori</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">archive</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">date_ajout</TD><TD ALIGN="LEFT">DATETIME</TD></TR></TABLE>>];
"theme" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>theme</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_theme</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">libelle</TD><TD ALIGN="LEFT">VARCHAR</TD></TR></TABLE>>];
"mot_cle" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>mot_cle</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK </TD><TD ALIGN="LEFT">id_mot_cle</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">libelle</TD><TD ALIGN="LEFT">VARCHAR</TD></TR></TABLE>>];
"collection_mot_cle" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b6c2b5"><TR><TD COLSPAN="3" BGCOLOR="#173f35"><FONT COLOR="white"><B>collection_mot_cle</B></FONT></TD></TR><TR><TD ALIGN="LEFT">PK FK </TD><TD ALIGN="LEFT">id_collection_fragment</TD><TD ALIGN="LEFT">INT</TD></TR><TR><TD ALIGN="LEFT">PK FK </TD><TD ALIGN="LEFT">id_mot_cle</TD><TD ALIGN="LEFT">INT</TD></TR></TABLE>>];
"fragment" -> "utilisateur" [label="id_createur → id_utilisateur"];
"fragment" -> "type_fragment" [label="id_type_fragment → id_type_fragment"];
"fragment" -> "auteur" [label="id_auteur → id_auteur"];
"collection_theme" -> "collection_fragment" [label="id_collection_fragment → id_collection_fragment"];
"collection_theme" -> "theme" [label="id_theme → id_theme"];
"collection_fragment" -> "utilisateur" [label="id_utilisateur → id_utilisateur"];
"collection_fragment" -> "fragment" [label="id_fragment → id_fragment"];
"collection_fragment" -> "humeur" [label="id_humeur → id_humeur"];
"collection_fragment" -> "mode_archivage" [label="id_mode_archivage → id_mode_archivage"];
"collection_mot_cle" -> "collection_fragment" [label="id_collection_fragment → id_collection_fragment"];
"collection_mot_cle" -> "mot_cle" [label="id_mot_cle → id_mot_cle"];
}
